  "info": {
    "title": "SabiMarket API",
    "description": "Backend API for the SabiMarket AI voice-first market assistant.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "trader@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "fullName": {
            "type": "string",
            "example": "Aisha Bello"
          },
          "phoneNumber": {
            "type": "string",
            "example": "08031234567"
          },
          "marketLocation": {
            "type": "string",
            "example": "Balogun Market"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "trader@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
