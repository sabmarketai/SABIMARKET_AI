generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inventory {
  user_id    String    @id @db.Uuid
  items      Json?
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transactions {
  id                BigInt              @id @default(autoincrement())
  user_id           String?             @db.Uuid
  transaction_type  String?
  transaction_date  DateTime?           @default(now()) @db.Timestamptz(6)
  total_amount      Decimal?            @db.Decimal(12, 2)
  profit            Decimal?            @db.Decimal(12, 2)
  currency          String?             @default("NGN")
  note              String?
  synced            Boolean?            @default(false)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  transaction_items transaction_items[]
  users             users?              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                    String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone_number          String            @unique
  email                 String?
  full_name             String?
  market_location       String?
  created_at            DateTime?         @default(now()) @db.Timestamptz(6)
  reputation_score      Int?              @default(0)
  total_transactions    Int?              @default(0)
  preferred_language    String?           @default("pidgin")
  notifications_enabled Boolean           @default(true)
  allow_notifications   Boolean           @default(false)
  community_posts       community_posts[]
  inventory             inventory?
  inventory_items       inventory_items[]
  market_prices         market_prices[]
  transactions          transactions[]
  notifications         notifications[]
}

model community_posts {
  id         BigInt    @id @default(autoincrement())
  user_id    String?   @db.Uuid
  title      String?
  content    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model inventory_items {
  id           BigInt    @id @default(autoincrement())
  user_id      String?   @db.Uuid
  item_name    String?
  quantity     Decimal?  @db.Decimal
  unit         String?
  average_cost Decimal?  @db.Decimal(12, 2)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model market_prices {
  id           BigInt    @id @default(autoincrement())
  market_name  String?
  item_name    String?
  price        Decimal?  @db.Decimal(12, 2)
  submitted_by String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users?    @relation(fields: [submitted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model transaction_items {
  id             BigInt        @id @default(autoincrement())
  transaction_id BigInt?
  item_name      String?
  quantity       Decimal?      @db.Decimal
  unit           String?
  unit_price     Decimal?      @db.Decimal(12, 2)
  total_price    Decimal?      @db.Decimal(12, 2)
  transactions   transactions? @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id         BigInt   @id @default(autoincrement())
  user_id    String   @db.Uuid
  type       String
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}
